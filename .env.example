# Edit only the root .env. Never commit it.
GOOGLE_SHEET_ID=
# Optional separate spreadsheet used only by --test-sheets; never use production ID here.
TEST_GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
APIFY_TOKEN=
# Preferred multi-account configuration. Comma-separated, any number; takes priority over APIFY_TOKEN.
APIFY_TOKENS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ENABLED=false
GEMINI_MAX_JOBS_PER_DIGEST=20
GEMINI_MAX_REQUESTS_PER_RUN=5
GEMINI_MAX_OUTPUT_TOKENS=4000
APIFY_ENABLE_LINKEDIN=false
APIFY_ENABLE_NAUKRI=false
APIFY_ENABLE_IIMJOBS=false
APIFY_ENABLE_GLASSDOOR=false
APIFY_ENABLE_GOOGLE_JOBS=false
APIFY_ENABLE_WORKDAY=false
# Optional: JSON inputs keyed by actor alias. No actor is called unless its enable flag is true.
APIFY_ACTOR_INPUTS_JSON={}
# Evidence you have checked from a credible source, keyed by company name.
# Example: {"Example Pvt Ltd":{"classification":"Startup","founding_year":2018,"employee_count":120,"source":"https://..."}}
COMPANY_EVIDENCE_JSON={}
APIFY_MAX_ITEMS_PER_ACTOR=50
MINIMUM_CTC_LPA=8
MINIMUM_INTERNSHIP_STIPEND_INR_MONTHLY=10000
MAXIMUM_EXPERIENCE_YEARS=3
TIMEZONE=Asia/Kolkata
DAILY_RUN_TIME=09:00
# Role-first discovery: comma-separated role queries and supported broad portals.
# Leave TARGET_BOARDS_JSON as [] unless you optionally want to monitor named employers too.
ROLE_QUERIES=marketing associate,digital marketing executive,business development executive,sales associate,financial analyst,business analyst,data analyst,hr executive,operations executive,management trainee,consulting analyst
PORTAL_SOURCES=naukri,linkedin,indeed,google,glassdoor
PORTAL_RESULTS_PER_QUERY=25
PORTAL_FETCH_DESCRIPTIONS=true
# JSON list of public company boards, e.g. [{"ats":"greenhouse","company":"Example","board":"example"}]
TARGET_BOARDS_JSON=[]
REQUEST_TIMEOUT_SECONDS=25
MAX_CONNECTOR_JOBS=250
SEND_EMAIL=true
# Production writes/email require both this flag and the --production command switch.
PRODUCTION_ENABLED=false
